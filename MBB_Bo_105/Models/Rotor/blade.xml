<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- One main rotor blade, written by fdm/rotorvis.py (see there); bo105.xml gives each
     instance its blade's properties in params -->

<PropertyList>
  <!-- TEST: the livery texture swaps taken out, to measure their cost (temporary) -->

  <path>blade-rotor.ac</path>

  <params>
    <lag>rotors/main/blade[0]/lag-deg</lag>
    <flap>rotors/main/blade[0]/flap-deg</flap>
    <pitch>rotors/main/blade[0]/incidence-deg</pitch>
  </params>

  <!-- the livery's paint (Models/Variants): the blade, plain, orange-tipped or white-striped -->

  <!-- and its blur -->

  <!-- the parts' detail texture and PBR (fdm/materials.py) -->
  <effect>
    <inherits-from>Effects/model-pbr</inherits-from>
    <parameters>
      <base-color-factor type="vec4d">0.2472 0.2472 0.1971 1.0</base-color-factor>      <!-- mil_metal_fade, cast -->
      <metallic-factor type="float">0.8</metallic-factor>
      <roughness-factor type="float">0.45</roughness-factor>
    </parameters>
    <object-name>mr_pendulum</object-name>
    <object-name>mr_absorber</object-name>
    <object-name>mr_fitting</object-name>
    <object-name>mr_horn</object-name>
    <object-name>mr_fork</object-name>
  </effect>

  <!-- the fan fades in with the rpm; its shadow x 2: two wedges over each point -->
  <effect>
    <inherits-from>../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <fade-from type="float"> 33.9191 </fade-from>
      <fade-to type="float"> 262.873 </fade-to>
      <pbr-roughness type="float"> 1 </pbr-roughness>
      <shadow-gain type="float"> 2 </shadow-gain>
    </parameters>
    <object-name>mr_blur0</object-name>
    <object-name>mr_blur1</object-name>
    <object-name>mr_blur2</object-name>
    <object-name>mr_blur3</object-name>
    <object-name>mr_blur4</object-name>
    <object-name>mr_blur5</object-name>
    <object-name>mr_blur6</object-name>
    <object-name>mr_blur7</object-name>
    <object-name>mr_blur8</object-name>
    <object-name>mr_blur9</object-name>
    <object-name>mr_blur10</object-name>
    <object-name>mr_blur11</object-name>
    <object-name>mr_blur12</object-name>
    <object-name>mr_blur13</object-name>
    <object-name>mr_blur14</object-name>
    <object-name>mr_blur15</object-name>
    <object-name>mr_blur16</object-name>
    <object-name>mr_blur17</object-name>
    <object-name>mr_blur18</object-name>
    <object-name>mr_blur19</object-name>
    <object-name>mr_blur20</object-name>
    <object-name>mr_blur21</object-name>
    <object-name>mr_blur22</object-name>
    <object-name>mr_blur23</object-name>
  </effect>

  <!-- the blade fades out -->
  <effect>
    <inherits-from>../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <fade-from type="float"> 262.873 </fade-from>
      <fade-to type="float"> 33.9191 </fade-to>
      <pbr-roughness type="float"> 0.5 </pbr-roughness>
      <shadow-gain type="float"> 1 </shadow-gain>
    </parameters>
    <object-name>tmr_blade</object-name>
    <object-name>tmr_blade_a</object-name>
    <object-name>tmr_blade_b</object-name>
    <object-name>tmr_blade_c</object-name>
    <object-name>tmr_blade_d</object-name>
    <object-name>tmr_blade_e</object-name>
  </effect>

  <!-- the opaque blade at low rpm -->
  <animation>
    <type>select</type>
    <object-name>mr_blade</object-name>
    <object-name>mr_blade_a</object-name>
    <object-name>mr_blade_b</object-name>
    <object-name>mr_blade_c</object-name>
    <object-name>mr_blade_d</object-name>
    <object-name>mr_blade_e</object-name>
    <condition>
      <less-than><property>rotors/main/rpm</property><value> 33.9191 </value></less-than>
    </condition>
  </animation>

  <!-- then its fading copy -->
  <animation>
    <type>select</type>
    <object-name>tmr_blade</object-name>
    <object-name>tmr_blade_a</object-name>
    <object-name>tmr_blade_b</object-name>
    <object-name>tmr_blade_c</object-name>
    <object-name>tmr_blade_d</object-name>
    <object-name>tmr_blade_e</object-name>
    <condition>
      <and>
        <not><less-than><property>rotors/main/rpm</property><value> 33.9191 </value></less-than></not>
        <less-than><property>rotors/main/rpm</property><value> 262.873 </value></less-than>
      </and>
    </condition>
  </animation>

