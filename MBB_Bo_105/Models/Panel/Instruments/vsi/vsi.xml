      <y-m> 0.0388 </y-m>
      <z-m> 0.0161 </z-m>
    </position>
    <direction>
      <lookat-x-m> 0.0097 </lookat-x-m>
      <lookat-y-m> 0.0000 </lookat-y-m>
      <lookat-z-m> 0.0000 </lookat-z-m>
    </direction>
    <color>
      <r> 0.10 </r>
      <g> 1.00 </g>
      <b> 0.45 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/instruments</property>
      <scale> 8.05275e-06 </scale>
    </intensity>
    <spot-exponent> 3 </spot-exponent>
    <spot-cutoff> 59.6 </spot-cutoff>
    <range-m> 0.090 </range-m>
  </light>

