    <object-name>bezel-lamp-5</object-name>
    <object-name>bezel-lamp-6</object-name>
    <object-name>bezel-lamp-7</object-name>
    <condition>
      <greater-than>
        <property>/instrumentation/bo105/lights/instruments</property>
        <value>0</value>
      </greater-than>
    </condition>
  </animation>

  <light>
