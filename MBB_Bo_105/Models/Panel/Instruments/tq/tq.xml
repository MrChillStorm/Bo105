    <parameters>
      <texture n="2">
        <image>Aircraft/MBB_Bo_105/Models/Textures/case-orm-30.png</image>
        <type>2d</type>
        <filter>nearest</filter>
        <mag-filter>nearest</mag-filter>
        <wrap-s>repeat</wrap-s>
        <wrap-t>repeat</wrap-t>
      </texture>
      <metallic-factor type="float"> 0 </metallic-factor>
      <roughness-factor type="float"> 1 </roughness-factor>
    </parameters>
    <object-name>case</object-name>
  </effect>

  <animation>
    <type>rotate</type>
    <object-name>eng1</object-name>
    <property>/engines/engine[0]/torque-pct</property>
    <interpolation>
      <entry><ind> -10 </ind><dep> 186 </dep></entry>
      <entry><ind> 0 </ind><dep> 190 </dep></entry>
      <entry><ind> 120 </ind><dep> 394 </dep></entry>
      <entry><ind> 130 </ind><dep> 398 </dep></entry>
    </interpolation>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.00000 </z-m>
    </center>
