    <object-name>symbol</object-name>
    <emission>
      <factor-prop>/instrumentation/bo105/lights/instruments</factor-prop>
      <red> 0.10 </red>
      <green> 1.00 </green>
      <blue> 0.45 </blue>
    </emission>
  </animation>

  <light>
