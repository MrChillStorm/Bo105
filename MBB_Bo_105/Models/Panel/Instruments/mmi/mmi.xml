      <z-m> 0.0170 </z-m>
    </position>
    <direction>
      <lookat-x-m> 0.0085 </lookat-x-m>
      <lookat-y-m> 0.0000 </lookat-y-m>
      <lookat-z-m> 0.0060 </lookat-z-m>
    </direction>
    <color>
      <r> 0.10 </r>
      <g> 1.00 </g>
      <b> 0.45 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/instruments</property>
      <scale> 3.58265e-06 </scale>
    </intensity>
    <spot-exponent> 3 </spot-exponent>
    <spot-cutoff> 59.2 </spot-cutoff>
    <range-m> 0.062 </range-m>
  </light>

