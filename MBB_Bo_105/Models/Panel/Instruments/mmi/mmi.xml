<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- mast moment indicator, flight manual fig. 7-3, 2.17.3 and 7.7.5: % of the hub moment limit; written by fdm/cockpit/gauges.py -->

<PropertyList>

