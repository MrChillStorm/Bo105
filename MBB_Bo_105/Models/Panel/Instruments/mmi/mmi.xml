  <effect>
    <inherits-from>Effects/model-pbr</inherits-from>
    <parameters>
      <texture n="2">
        <image>Aircraft/MBB_Bo_105/Models/Textures/case-orm-30.png</image>
        <type>2d</type>
        <filter>nearest</filter>
        <mag-filter>nearest</mag-filter>
        <wrap-s>repeat</wrap-s>
        <wrap-t>repeat</wrap-t>
      </texture>
      <metallic-factor type="float"> 0 </metallic-factor>
      <roughness-factor type="float"> 1 </roughness-factor>
    </parameters>
    <object-name>case</object-name>
  </effect>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>/instrumentation/mmi/indicated-pct</property>
    <interpolation>
      <entry><ind> -1e+06 </ind><dep> -140.85 </dep></entry>
      <entry><ind> 0 </ind><dep> -135 </dep></entry>
      <entry><ind> 130 </ind><dep> 118.5 </dep></entry>
      <entry><ind> 1e+06 </ind><dep> 124.35 </dep></entry>
    </interpolation>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.00600 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>test</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-assign</command>
        <property>/instrumentation/mmi/test</property>
        <value type="bool">true</value>
      </binding>
      <mod-up>
        <binding>
          <command>property-assign</command>
          <property>/instrumentation/mmi/test</property>
          <value type="bool">false</value>
        </binding>
      </mod-up>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>test</tooltip-id>
        <label>Mast moment indicator TEST</label>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>test</object-name>
    <property>/instrumentation/mmi/test</property>
    <factor> -0.002 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>material</type>
    <object-name>limit</object-name>
    <condition>
      <property>/instrumentation/mmi/limit-light</property>
    </condition>
    <emission>
      <red> 1.00 </red>
      <green> 0.10 </green>
      <blue> 0.06 </blue>
    </emission>
  </animation>

  <effect>
    <inherits-from>Aircraft/MBB_Bo_105/Models/Effects/Lit/lit</inherits-from>
    <parameters>
      <lit-color type="vec3d"> 1.00 1.00 1.00 </lit-color>
      <lit-level type="float"><use>/instrumentation/bo105/lights/hdr/mmi-limit</use></lit-level>
      <lit-gain type="float"> 1 </lit-gain>
      <lit-reflectance type="float"> 0.3 </lit-reflectance>
    </parameters>
    <object-name>limit</object-name>
  </effect>

</PropertyList>
