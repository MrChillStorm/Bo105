    <object-name>ptr0</object-name>
    <property>/consumables/fuel/tank[0]/level-lbs</property>
    <interpolation>
      <entry><ind> -1e+06 </ind><dep> -144 </dep></entry>
      <entry><ind> 0 </ind><dep> -140 </dep></entry>
