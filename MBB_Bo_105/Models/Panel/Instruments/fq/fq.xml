    <object-name>bezel-lamp-5</object-name>
    <object-name>bezel-lamp-6</object-name>
    <object-name>bezel-lamp-7</object-name>
    <condition>
      <greater-than>
        <property>/instrumentation/bo105/lights/instruments</property>
        <value>0</value>
      </greater-than>
    </condition>
  </animation>

  <light>
    <name>bezel-lamp-0</name>
    <type>spot</type>
    <position>
      <x-m> 0.0119 </x-m>
      <y-m> 0.0250 </y-m>
      <z-m> 0.0103 </z-m>
    </position>
    <direction>
      <lookat-x-m> 0.0083 </lookat-x-m>
      <lookat-y-m> 0.0000 </lookat-y-m>
      <lookat-z-m> 0.0000 </lookat-z-m>
    </direction>
    <color>
      <r> 0.10 </r>
      <g> 1.00 </g>
      <b> 0.45 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/instruments</property>
      <scale> 3.1583e-06 </scale>
    </intensity>
    <spot-exponent> 3 </spot-exponent>
    <spot-cutoff> 58.5 </spot-cutoff>
    <range-m> 0.058 </range-m>
  </light>

