<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- dual fuel quantity indicator, flight manual fig. 7-3 and 7.6.3: main tank M, supply tank S, kg x 10; written by fdm/cockpit/gauges.py -->

<PropertyList>

  <path>fq.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>case</object-name>
    <object-name>dial</object-name>
    <object-name>ptr0</object-name>
    <object-name>ptr1</object-name>
    <object-name>glass</object-name>
