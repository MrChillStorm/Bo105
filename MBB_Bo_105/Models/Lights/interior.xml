<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- the interior lights, written by fdm/hdrmodel.py (see there): HDR spot
     lights at their levels in /instrumentation/bo105/lights/ -->

<PropertyList>

  <light>
    <name>whip-light</name>
    <type>spot</type>
    <position>
      <x-m> -1.85 </x-m>
      <y-m> -0.12 </y-m>
      <z-m> 0.42 </z-m>
    </position>
    <direction>
      <lookat-x-m> -2.21 </lookat-x-m>
      <lookat-y-m> 0.1 </lookat-y-m>
      <lookat-z-m> 0.33 </lookat-z-m>
    </direction>
    <color>
      <r> 0.1 </r>
      <g> 1 </g>
      <b> 0.45 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/whip</property>
      <scale> 0.00125984 </scale>
    </intensity>      <!-- 0.8 cd at full -->
    <spot-exponent> 2 </spot-exponent>
    <spot-cutoff> 35 </spot-cutoff>
    <range-m> 0.9 </range-m>
  </light>

  <light>
    <name>utility-light</name>
    <type>spot</type>
    <position>
      <x-m> -1.65 </x-m>
      <y-m> -0.12 </y-m>
      <z-m> 0.95 </z-m>
    </position>
    <direction>
      <lookat-x-m> -2.21 </lookat-x-m>
      <lookat-y-m> 0.12 </lookat-y-m>
      <lookat-z-m> 0.38 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 0.95 </g>
      <b> 0.85 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/utility</property>
      <scale> 0.00472441 </scale>
    </intensity>      <!-- 3 cd at full -->
    <spot-exponent> 2 </spot-exponent>
    <spot-cutoff> 32 </spot-cutoff>
    <range-m> 1.3 </range-m>
  </light>

  <light>
    <name>cabin-light</name>
    <type>spot</type>
    <position>
      <x-m> -0.8 </x-m>
      <y-m> 0 </y-m>
      <z-m> 1 </z-m>
    </position>
    <direction>
      <lookat-x-m> -0.8 </lookat-x-m>
      <lookat-y-m> 0 </lookat-y-m>
      <lookat-z-m> 0 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 0.95 </g>
      <b> 0.85 </b>
    </color>
    <intensity>
      <property>/instrumentation/bo105/lights/cabin</property>
      <scale> 0.0188976 </scale>
    </intensity>      <!-- 12 cd at full -->
    <spot-exponent> 1 </spot-exponent>
    <spot-cutoff> 75 </spot-cutoff>
    <range-m> 1.5 </range-m>
  </light>

</PropertyList>
