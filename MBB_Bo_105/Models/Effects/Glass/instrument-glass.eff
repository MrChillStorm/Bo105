<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- The instruments' glass. In the HDR pipeline, clear glass (Shaders/HDR/instrument_glass.frag): no light of its
     own, the dial seen through it dimmed by the faces' Fresnel reflection, and the sun's image where it reaches the
     glass. The blend is premultiplied, so that the glint isn't scaled down by the glass's opacity. The other
     pipelines keep the glass effect. -->

<PropertyList>

  <name>instrument-glass</name>
  <inherits-from>Aircraft/MBB_Bo_105/Models/Effects/Glass/glass</inherits-from>

  <technique n="128">
    <pass>
      <blend>
        <source-rgb>one</source-rgb>
      </blend>
      <define n="300">
        <name>BLEND_PREMULTIPLIED</name>
      </define>
      <program>
        <fragment-shader n="0">Aircraft/MBB_Bo_105/Shaders/HDR/instrument_glass.frag</fragment-shader>
      </program>
    </pass>
  </technique>

</PropertyList>
